# ─── .env.local.example ──────────────────────────────────────────────────────
# Template for the local developer environment file.
#
# USAGE:
#   cp .env.local.example .env.local
#   # Edit .env.local with your values (it is gitignored)
#   make cluster-up
#
# 12-Factor App — Factor III (Config):
#   This file documents the full config contract for the local environment.
#   For production (GCP/AWS), the same variables are injected by:
#     - Kubernetes Secrets
#     - GCP Secret Manager + Workload Identity
#     - AWS Secrets Manager + IAM roles
#
# SECURITY: .env.local is gitignored. NEVER commit real credentials.
#           .env.local.example (this file) IS committed — it contains only
#           safe placeholder defaults, not real secrets.
#
# MIGRATION: To deploy to GCP, create .env.gcp with production values.
#            Run: ENV_FILE=.env.gcp make validate-env
# ─────────────────────────────────────────────────────────────────────────────

# ── Compose Project ───────────────────────────────────────────────────────────
# Namespaces all Docker resources (containers, networks, volumes).
# Change this if you run multiple instances of this project.
COMPOSE_PROJECT_NAME=fraud-pipeline

# ── PostgreSQL — OLTP Warehouse & Airflow Metadata DB ────────────────────────
# Local:  Expose on host port 5434 to avoid conflicts with system Postgres.
#         Inside fraud_vpc, services connect to postgres:5432 (Docker DNS).
# GCP:    Cloud SQL for PostgreSQL (private IP via VPC connector)
# AWS:    Amazon RDS for PostgreSQL
POSTGRES_PASSWORD=changeme_local_only

# ── MinIO — S3-Compatible Object Storage ─────────────────────────────────────
# Local:  MinIO container — http://minio:9000 inside fraud_vpc
# GCP:    Google Cloud Storage (endpoint: https://storage.googleapis.com)
# AWS:    Amazon S3 (endpoint: https://s3.<region>.amazonaws.com)
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# MinIO bucket alias for the mc CLI (minio-init container).
# Change to any identifier; has no effect on application code.
MINIO_ALIAS=fraud-local

# ── Kafka — Event Streaming ───────────────────────────────────────────────────
# LOCAL (host processes): Kafka exposed on localhost:9092 via mapped port.
# INSIDE fraud_vpc:       Services connect to kafka:29092 (Docker DNS).
# GCP:    Confluent Cloud bootstrap (e.g., pkc-xxx.europe-west2.gcp.confluent.cloud:9092)
# AWS:    Amazon MSK bootstrap
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ── Redis — Feature Store Cache ───────────────────────────────────────────────
# LOCAL (host processes): Exposed on localhost:6379 via mapped port.
# INSIDE fraud_vpc:       Services connect to redis:6379 (Docker DNS).
# GCP:    Memorystore for Redis (private IP)
# AWS:    ElastiCache primary endpoint
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ── PostgreSQL — Host-Side Process Config ─────────────────────────────────────
# Used by host-side Python processes (Makefile targets: seed, load, features).
# Port 5434 = host-mapped port from postgres container (which listens on 5432).
PG_HOST=127.0.0.1
PG_PORT=5434
PG_DATABASE=fraud_reference
PG_USER=fraud_admin
PG_PASSWORD=changeme_local_only

# ── MinIO — Host-Side Process Config ─────────────────────────────────────────
# Used by host-side Spark processes (make stream-bronze, make load-bronze).
MINIO_ENDPOINT=http://localhost:9000

# ── Apache Spark ──────────────────────────────────────────────────────────────
# LOCAL:  spark://spark-master:7077 — Docker Compose cluster (via spark-submit)
#         When running the job on the HOST (not inside a container), the
#         Spark driver connects to the cluster master via the mapped port.
# GCP:    spark://dataproc-cluster-m:7077 (or yarn)
# AWS:    yarn (EMR) or spark://emr-master:7077
SPARK_MASTER_URL=spark://localhost:7077
SPARK_DRIVER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=1g

# ── Feature Store API ───────────────────────────────────────────────────
# Used by the FastAPI serving layer (make api-up) and mock_ml_scorer.
# Rotate this to a cryptographically random secret in production.
# GCP:    Store in Secret Manager, inject via Workload Identity.
# AWS:    Store in Secrets Manager, inject via IAM role.
# API_HOST / API_PORT: where the scorer looks for the API.
API_KEY=sk_test_local_only_change_in_prod
API_HOST=localhost
API_PORT=8002

# ── dbt ───────────────────────────────────────────────────────────────────────
DBT_TARGET=dev
DBT_SCHEMA=silver
DBT_THREADS=4

# ── Debezium Kafka Connect ────────────────────────────────────────────────────
# URL for the connector registration script (make connector).
CONNECT_URL=http://localhost:8083
